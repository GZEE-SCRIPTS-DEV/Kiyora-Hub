# Cabeçalhos de segurança (Cloudflare Pages)
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  # Parte segura do CSP: já pode ficar ativa (não quebra nada)
  Content-Security-Policy: frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self'
  # CSP completo em modo de teste: só avisa no console (F12), não bloqueia.
  # Quando não houver avisos ao navegar, troque o nome por "Content-Security-Policy".
  # Atenção: os hashes sha256 mudam toda vez que o <script> do index.html for editado.
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'sha256-bfMyE00hZytR3uWErwrFnucjRl6ResjccySVHHn1re8=' 'sha256-accjsO9bAD9C4bz5pGUMQxFiiBnE1XPWDeUMQ4xyoEg=' 'sha256-jJxjL6+XIk5TfagzMRDcE3WrTmySdy8olhAZPjiUqMw=' 'sha256-onU9P3R1nlN9E4lxTVAOq+GwlFlMSCbODUoWdCi1VM8=' https://www.gstatic.com https://apis.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' blob: https:; connect-src 'self' https://*.googleapis.com https://*.firebaseio.com wss://*.firebaseio.com https://zone.api.br https://cdn.zone.api.br; frame-src https://kiyora-hub-6c399.firebaseapp.com https://accounts.google.com; worker-src 'self' blob:; manifest-src 'self'

/functions/*
  Cache-Control: no-store
